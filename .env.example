# akgentic community stack — environment for docker-compose.yml
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Variables that are UNCOMMENTED with an empty value are REQUIRED. Variables
# that are COMMENTED OUT are optional: the `${VAR:-default}` fallback shown in
# docker-compose.yml applies, and the value after the `=` below is that default.

# =============================================================================
# API keys
# =============================================================================

# Required — the LLM provider key the agents run on.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — enables the Tavily web-search tool. Agents configured with that
# tool fail to search when this is unset; the rest of the stack is unaffected.
# https://app.tavily.com/
TAVILY_API_KEY=

# =============================================================================
# Published host ports
# =============================================================================
# Container ports are fixed (server 8000, nginx 4200); these remap only what is
# published on the host. The defaults match, so the stack lands on the same
# ports the README documents for running the server and UI without Docker —
# convenient, but you cannot run both at once. Change these (and API_URL with
# SERVER_PORT) if you want the two side by side.

# Web UI            -> http://localhost:4200
FRONTEND_PORT=4200

# REST API and docs -> http://localhost:8000/docs
SERVER_PORT=8000

# The backend URL the BROWSER calls. Must match SERVER_PORT — change both
# together. This is not the compose-internal address: the request is made by
# the browser, so `http://server:8000` would not resolve.
API_URL=http://localhost:8000

# =============================================================================
# Optional
# =============================================================================

# Where the backend's akgentic-* packages come from.
#
#   wheel   (default)  Install from PyPI at the pins in pyproject.toml /
#                      uv.lock — the declared release set. No submodule
#                      checkout needed.
#   source             Install EDITABLE from packages/akgentic-*, to run the
#                      stack against modified framework sources. Requires
#                      `git submodule update --init` first. External
#                      dependencies still come from uv.lock.
#
# Mirrors FRONTEND_SOURCE below: published artifact by default, local sources
# when you are changing the code.
# BUILD_SOURCE=wheel

# Where the frontend bundle comes from.
#
#   release  (default)  Download the prebuilt bundle from the akgentic-frontend
#                       GitHub release named by FRONTEND_VERSION. Fast, no Node
#                       toolchain, and the packages/akgentic-frontend submodule
#                       does NOT need to be initialised.
#   source              Build from packages/akgentic-frontend. Use when you are
#                       changing the frontend, or want BUILD_MODE=development.
#                       Requires `git submodule update --init
#                       packages/akgentic-frontend` first.
# FRONTEND_SOURCE=release

# Which release to pull under FRONTEND_SOURCE=release is pinned in
# ./package.json (dependencies.akgentic-frontend) — bump it THERE, so the
# version the stack serves is tracked in git rather than living in an untracked
# .env. Set this only to override that pin for a one-off test. Ignored by
# FRONTEND_SOURCE=source.
# Releases: https://github.com/b12consulting/akgentic-frontend/releases
# FRONTEND_VERSION=

# Angular build configuration. Applies to FRONTEND_SOURCE=source ONLY; the
# release artifact is always built at --configuration production. 'production'
# optimises and hashes the bundle; 'development' keeps source maps.
# BUILD_MODE=production

# Server log level: DEBUG, INFO, WARNING, ERROR, CRITICAL. An unrecognised
# value warns and falls back to INFO.
# LOG_LEVEL=INFO

# Allowed CORS origins, as a JSON list — the browser calls the API from a
# different port, so this must admit the UI's origin. Narrow it before exposing
# the stack beyond localhost; `[]` disables the middleware entirely.
# CORS_ORIGINS=["*"]
